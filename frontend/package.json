    "@tarojs/shared": "^4.0.0",
    "@tarojs/taro": "^4.0.0",
    "classnames": "^2.5.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-react": "^7.29.7",
